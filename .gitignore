prompts/
naming/
cd/
python3/

# CODEX notes (internal)
CODEX.md
tools/decomp-permuter/

# IDO compiler binaries (too large for repo)
tools/ido-static-recomp/
tools/ido5.3_compiler/
tools/ido7.1/

# Temporary task files
tools/CODEX_*.md

# Permuter output directories  
permuter/*/output-*/

# Compiled objects in work directories
work/**/*.o
.pytest_cache/

# 008: the blob image's passthrough asm and linker script are generated from
# the ROM-derived image plus build/blob_layout.json in well under a second
# (`blob_layout derive && blob_tu generate`). Spliced C bodies under
# src/blob/*.c ARE tracked; the scaffolding around them is not.
asm/us/blob/*
# Cloud scoring needs the generated splice-resolver addresses in a fresh clone.
!asm/us/blob/symbols.json
!asm/us/blob/SHA256SUMS
src/blob/blob.ld
tools/cloud/ido/

# Third-party reference copies (see docs/external/README.md)
docs/external/files/
# Generated variant sweeps from matching agents (recreated by the gen/batch scripts)
cloud/work/frontier/w*/*/[be][0-9]*/
