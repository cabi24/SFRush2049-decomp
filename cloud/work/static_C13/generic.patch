+def test_no_owner_split_keeps_original_binary_recipe(owner,monkeypatch):
+    repo,row,reg=owner;reg['rom_slots']=[];save(repo,reg);calls=[];monkeypatch.setattr(O.subprocess,'run',lambda a,**k:calls.append(a))
