+SECTION_PADDING = 16    # IDO aligns (and pads) its data sections to 16 bytes
+
+
+def _independent_regions(name, windows, opened, section_size, image, regions):
+    """(None, placements) when one function's verified windows into a
+    read-only section may sit at independent retail addresses, else
+    (reason, None). The fallback after the one-base rule refused.
+
+    windows  [(object offset, stop, retail address, object bytes of
+             [offset, stop) with table entries applied, widest access, uses,
+             compared length)] for every window of the section that verified
+    opened   how many windows the function's references open in the section
+
+    Complete evidence, or a refusal:
+      * every window the function opens in the section verified (none failed
+        or stayed unverified);
+      * each window is compared over its WHOLE extent [offset, stop), up to
+        the next referenced object, trailing zeros included: no object byte a
+        reference reaches rides along unchecked once the windows no longer
+        sit side by side as in the object. The one exception is the window
+        that ends the section: its trailing zeros past the compared length
+        are IDO's section padding (another owner's data in the image, as for
+        the one-base rule) and are not compared, but only when they are fewer
+        than SECTION_PADDING bytes;
+      * the extent is at least as wide as every access made through it;
+      * `regions` accepts each extent (in the image, outside function code);
+      * no two windows occupy the same image bytes.
+    The placements are those whole extents."""
+    if len(windows) != opened:
+        return (f"{opened - len(windows)} of the {opened} references into {name} "
+                "did not verify"), None
+    placed = []
+    for offset, stop, address, data, widest, uses, length in sorted(windows):
+        at = "/".join(f"+0x{ref.lo_site:x}" for _a, ref, _w in uses)
+        size = stop - offset
+        if size < widest:
+            return (f"{name}+0x{offset:x} (read at {at}): {widest}-byte access, but the "
+                    f"next referenced object starts {size} bytes later"), None
+        if stop >= section_size:
+            if size - length >= SECTION_PADDING or any(data[length:]):
+                return (f"{name}+0x{offset:x}: {size - length} uncompared bytes at the "
+                        "section end are more than its padding"), None
+            size, data, stop = length, data[:length], offset + length
+        expected = image.read(address, size)
+        if expected is None:
+            return (f"{name}+0x{offset:x}: retail bytes 0x{address:08X}+{size} "
+                    "are not available"), None
+        if expected != data:
+            first = next(i for i in range(size) if expected[i] != data[i])
+            return (f"{name}+0x{offset:x}..+0x{stop:x} differs from retail 0x{address:08X} "
+                    f"at +0x{first:x} (retail {expected[first:first + 4].hex()}, got "
+                    f"{data[first:first + 4].hex()}; whole extent compared)"), None
+        why = regions(address, size)
+        if why is not None:
+            return f"{name}+0x{offset:x} at 0x{address:08X}+{size}: {why}", None
+        placed.append((offset, stop, address, "rodata"))
+    ordered = sorted(placed, key=lambda p: p[2])
+    for first, second in zip(ordered, ordered[1:]):
+        if second[2] < first[2] + first[1] - first[0]:
+            return (f"{name}+0x{first[0]:x} and {name}+0x{second[0]:x} occupy the same "
+                    f"image bytes at 0x{second[2]:08X}"), None
+    return None, placed
+
