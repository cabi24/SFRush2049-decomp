+    /* 0x02 */ u8 active;
+    /* 0x03 */ s8 loaded;
+    /* 0x04 */ u8 mode;
+    /* 0x05 */ u8 pad5[7];
+    /* 0x0C */ void *data;
+    /* 0x10 */ s32 unk10;
+} ResSlot;
+
+typedef struct { u8 pad0[8]; u32 *dl; u8 padC[4]; } Part;
+typedef struct { u8 pad0[0x18]; Part part[4]; } Model;
