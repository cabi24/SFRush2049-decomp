void *sound_play_menu(Heap *heap, u32 size)
{
    Block *n;
    Block *b;
    u32 total;
    u32 largest;
    u32 bs;

    osRecvMesg(&D_80152770, 0, 1);
    total = 0;
    largest = 0;
    heap = heap_or_default(heap);
    size = (size + 31) & ~31;
    for (b = heap->last; b != 0; b = b->prev) {
        if (b->used == 0) {
            bs = b->size;
            total += bs;
            if (largest < bs) {
                largest = bs;
            }
            if (bs >= size) {
                break;
            }
        }
    }
    bs = b->size;
    if (bs - size >= 64) {
        n = b;
        b = (Block *)((u8 *)b + bs - size);
        b->next = n->next;
        if (b->next != 0) {
            b->next->prev = b;
        } else {
            heap->last = b;
        }
        b->prev = n;
        b->size = size;
        b->owner = 0;
        b->used = 1;
        b->tag = 0;
        b->pad16[0] = 0;
        b->magic = 0xFEDCBA98;
        n->next = b;
        n->size = n->size - size - 32;
    } else {
        b->owner = 0;
        b->used = 1;
        b->tag = 0;
    }
    osJamMesg(&D_80152770, 0, 0);
    return (u8 *)b + 32;
}
