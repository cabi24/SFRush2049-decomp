+   dst=self.repo/rel;dst.parent.mkdir(parents=True,exist_ok=True);shutil.copy(ROOT/rel,dst)
+  for f in ['Makefile','splat.us.yaml','rush2049.us.ld','include/PR/os_thread.h']:
