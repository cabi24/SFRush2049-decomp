diff --git a/m2c/rush_ipa.py b/m2c/rush_ipa.py
new file mode 100644
--- /dev/null
+++ b/m2c/rush_ipa.py
@@ -0,0 +1,31 @@
+"""rush2049: IDO -O3 interprocedural register allocation (IPA) support.
+
+Opt-in via the environment variable M2C_IPA_REGS, naming a JSON file
+{function_name: [register, ...]}: the non-ABI registers in which that
+function receives parameters (e.g. {"resource_slot_clear": ["t0"]}).
+
+With it set, m2c (1) gives a mapped function extra parameters for those
+registers, (2) passes those registers as extra arguments at calls to it, and
+(3) keeps a caller-save register's pre-call value instead of reporting it
+unset, because IPA lets callers keep values live across calls to callees
+known not to clobber them.
+"""
+import json
+import os
+from typing import Dict, List, Optional
+
+_MAP: Optional[Dict[str, List[str]]] = None
+
+
+def enabled() -> bool:
+    return bool(os.environ.get("M2C_IPA_REGS"))
+
+
+def regs_for(name: Optional[str]) -> List[str]:
+    global _MAP
+    if not name or not enabled():
+        return []
+    if _MAP is None:
+        with open(os.environ["M2C_IPA_REGS"]) as f:
+            _MAP = json.load(f)
+    return list(_MAP.get(name, []))
